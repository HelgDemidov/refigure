# Python cache / bytecode
__pycache__/
*.py[cod]

# Environments
.venv/
venv/
env/

# Packaging
dist/
build/
*.egg-info/

# Env files — .env.example (if any) stays tracked
.env
.env.local
.env.test

# Dev-tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS — .vscode/extensions.json is shared, rest is personal
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Claude CLI — sessions/memory local; commands/settings versioned explicitly
.claude/*
!.claude/commands/
!.claude/commands/*.md
!.claude/settings.json
CLAUDE.local.md

# Real-document integration test fixtures — large binaries, local-only
# (mirrors the source pipeline's own gitignored fixtures/local/ pattern).
# Provenance/license/checksums tracked in
# tests/integration/fixtures/manifest.yaml instead of the files themselves.
# NOTE (2026-08-05): most of this list is going away — 26/27 fixtures are
# being un-gitignored per docs/vlm-layer-port-2026-08-05.md §4, not yet
# executed as of this commit.
tests/integration/fixtures/docx/*.docx
tests/integration/fixtures/xlsx/*.xlsx
